// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums removed - SQLite doesn't support enums, using String instead

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  memberships          TeamMembership[]
  shifts               Shift[]
  notes                Note[]
  swapRequests         SwapRequest[]
  notifications        Notification[]
  holidayRequests      HolidayRequest[]
  notificationSettings NotificationSettings?

  @@map("teams")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  role        String    @default("EMPLOYEE")
  teamId      String
  azureOid    String?   @unique
  status      String    @default("active")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team                   Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMemberships        TeamMembership[]
  shifts                 Shift[]
  holidayRequests        HolidayRequest[]
  holidayDecisions       HolidayRequest[]            @relation("HolidayDecider")
  notesCreated           Note[]                      @relation("NoteCreator")
  swapRequestsMade       SwapRequest[]               @relation("SwapRequester")
  swapRequestsFrom       SwapRequest[]               @relation("SwapFromUser")
  swapRequestsTo         SwapRequest[]               @relation("SwapToUser")
  swapRequestsDecided    SwapRequest[]               @relation("SwapDecider")
  notifications          Notification[]
  notificationPreference UserNotificationPreference?

  @@map("users")
}

model ShiftType {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  color            String // hex color
  defaultStartTime String // HH:mm format
  defaultEndTime   String // HH:mm format
  crossesMidnight  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts Shift[]

  @@map("shift_types")
}

model Shift {
  id            String   @id @default(cuid())
  teamId        String
  userId        String
  date          String // YYYY-MM-DD format
  startDateTime DateTime
  endDateTime   DateTime
  shiftTypeId   String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType    ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)
  swapRequests SwapRequest[]

  @@index([teamId, date])
  @@index([userId, date])
  @@map("shifts")
}

model Note {
  id              String   @id @default(cuid())
  teamId          String
  createdByUserId String
  type            String
  status          String   @default("PENDING")
  title           String?
  body            String
  dateFrom        String // YYYY-MM-DD format
  dateTo          String // YYYY-MM-DD format
  visibility      String   @default("ALL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, dateFrom, dateTo])
  @@map("notes")
}

model SwapRequest {
  id                String    @id @default(cuid())
  teamId            String
  requestedByUserId String
  fromUserId        String
  toUserId          String
  shiftId           String
  status            String    @default("PENDING")
  message           String?
  createdAt         DateTime  @default(now())
  decidedBy         String?
  decidedAt         DateTime?

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy   User  @relation("SwapRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  fromUser      User  @relation("SwapFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User  @relation("SwapToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  shift         Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  decidedByUser User? @relation("SwapDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([requestedByUserId])
  @@map("swap_requests")
}

model Notification {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  type      String // e.g., "SHIFT_CREATED", "SWAP_EXECUTED", "NOTE_CREATED"
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, userId, read])
  @@map("notifications")
}

model NotificationSettings {
  id           String   @id @default(cuid())
  teamId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEndpoint  String? // placeholder for future SMS integration
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// Per-user preferences: which notification types to receive and via email/sms/both.
model UserNotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  shiftChangesEmail Boolean  @default(true)
  shiftChangesSms   Boolean  @default(false)
  swapEmail         Boolean  @default(true)
  swapSms           Boolean  @default(false)
  noteEmail         Boolean  @default(true)
  noteSms           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

// Team-scoped membership: role per team (leader/employee). User can have multiple teams.
model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      String // LEADER | EMPLOYEE
  status    String   @default("active") // active | inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

// Audit log for admin actions (user/membership changes).
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// Holiday / absence requests submitted by users and handled by team leaders.
model HolidayRequest {
  id        String    @id @default(cuid())
  teamId    String
  userId    String
  type      String // e.g. "HOLIDAY" | "SICK" | "OTHER"
  status    String    @default("PENDING")
  dateFrom  String // YYYY-MM-DD
  dateTo    String? // optional end date
  message   String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedByUser User? @relation("HolidayDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@map("holiday_requests")
}
