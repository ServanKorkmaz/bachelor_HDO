generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LEADER
  EMPLOYEE
}

enum MembershipRole {
  LEADER
  EMPLOYEE
}

enum ActiveStatus {
  active
  inactive
}

enum RequestStatus {
  AWAITING_ACCEPTANCE
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum NoteVisibility {
  ALL
  LEADERS
  TEAM
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  memberships          TeamMembership[]
  shifts               Shift[]
  notes                Note[]
  swapRequests         SwapRequest[]
  notifications        Notification[]
  holidayRequests      HolidayRequest[]
  notificationSettings NotificationSettings?

  @@map("teams")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  role        UserRole     @default(EMPLOYEE)
  // teamId is the user's "home" or primary team — kept for display labels and
  // sensible defaults when creating new objects on the user's behalf. The
  // authoritative source for "is this user currently allowed into team X?"
  // is the TeamMembership table (where membership status is also tracked).
  teamId      String
  azureOid    String?      @unique
  status      ActiveStatus @default(active)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team                   Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMemberships        TeamMembership[]
  shifts                 Shift[]
  holidayRequests        HolidayRequest[]
  holidayDecisions       HolidayRequest[]            @relation("HolidayDecider")
  notesCreated           Note[]                      @relation("NoteCreator")
  swapRequestsMade       SwapRequest[]               @relation("SwapRequester")
  swapRequestsFrom       SwapRequest[]               @relation("SwapFromUser")
  swapRequestsTo         SwapRequest[]               @relation("SwapToUser")
  swapRequestsDecided    SwapRequest[]               @relation("SwapDecider")
  notifications          Notification[]
  notificationPreference UserNotificationPreference?

  @@map("users")
}

model ShiftType {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  color            String
  defaultStartTime String
  defaultEndTime   String
  crossesMidnight  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts Shift[]

  @@map("shift_types")
}

model Shift {
  id            String   @id @default(cuid())
  teamId        String
  userId        String
  // `date` is the calendar day the shift belongs to (YYYY-MM-DD). It is
  // stored as a String rather than a DateTime / @db.Date so it can never be
  // shifted across timezones at the JSON/React boundary — a shift on the 27th
  // is the 27th regardless of where the user is reading from. Format and
  // validity are enforced by Zod (`dateString` in lib/validation/schemas.ts).
  date          String
  startDateTime DateTime
  endDateTime   DateTime
  shiftTypeId   String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType    ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)
  swapRequests SwapRequest[]

  @@unique([userId, date])
  @@index([teamId, date])
  @@map("shifts")
}

model Note {
  id              String         @id @default(cuid())
  teamId          String
  createdByUserId String
  type            String
  status          RequestStatus  @default(PENDING)
  title           String?
  body            String
  dateFrom        String
  dateTo          String
  visibility      NoteVisibility @default(ALL)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, dateFrom, dateTo])
  @@map("notes")
}

model SwapRequest {
  id                String        @id @default(cuid())
  teamId            String
  requestedByUserId String
  fromUserId        String
  toUserId          String
  shiftId           String
  status            RequestStatus @default(PENDING)
  message           String?
  createdAt         DateTime      @default(now())
  decidedBy         String?
  decidedAt         DateTime?

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy   User  @relation("SwapRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  fromUser      User  @relation("SwapFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User  @relation("SwapToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  shift         Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  decidedByUser User? @relation("SwapDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([requestedByUserId])
  @@map("swap_requests")
}

model Notification {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, userId, read])
  @@map("notifications")
}

model NotificationSettings {
  id           String   @id @default(cuid())
  teamId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEndpoint  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model UserNotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  shiftChangesEmail Boolean  @default(true)
  shiftChangesSms   Boolean  @default(false)
  swapEmail         Boolean  @default(true)
  swapSms           Boolean  @default(false)
  noteEmail         Boolean  @default(true)
  noteSms           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model TeamMembership {
  id        String         @id @default(cuid())
  userId    String
  teamId    String
  role      MembershipRole
  status    ActiveStatus   @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model HolidayRequest {
  id        String        @id @default(cuid())
  teamId    String
  userId    String
  type      String
  status    RequestStatus @default(PENDING)
  dateFrom  String
  dateTo    String?
  message   String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedByUser User? @relation("HolidayDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@map("holiday_requests")
}
