generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  LEADER
  EMPLOYEE
}

enum MembershipRole {
  LEADER
  EMPLOYEE
}

enum ActiveStatus {
  active
  inactive
}

enum RequestStatus {
  AWAITING_ACCEPTANCE
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum NoteVisibility {
  ALL
  LEADERS
  TEAM
}

enum NoteType {
  GENERAL
  INFO
  ABSENCE
  HOLIDAY
  SICKNESS
}

enum DeliveryChannel {
  EMAIL
  SMS
}

enum DeliveryStatus {
  SENT
  FAILED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  memberships          TeamMembership[]
  shifts               Shift[]
  notes                Note[]
  swapRequests         SwapRequest[]
  notifications        Notification[]
  holidayRequests      HolidayRequest[]
  notificationSettings NotificationSettings?
  weekNotes            WeekNote[]
  rotationPatterns     RotationPattern[]

  @@map("teams")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  role        UserRole     @default(EMPLOYEE)
  // teamId is the user's "home" or primary team. Kept for display labels and
  // sensible defaults when creating new objects on the user's behalf. The
  // authoritative source for "is this user currently allowed into team X?"
  // is the TeamMembership table (where membership status is also tracked).
  teamId      String
  azureOid    String?      @unique
  status      ActiveStatus @default(active)
  lastLoginAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team                   Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMemberships        TeamMembership[]
  shifts                 Shift[]
  holidayRequests        HolidayRequest[]
  holidayDecisions       HolidayRequest[]            @relation("HolidayDecider")
  notesCreated           Note[]                      @relation("NoteCreator")
  swapRequestsMade       SwapRequest[]               @relation("SwapRequester")
  swapRequestsFrom       SwapRequest[]               @relation("SwapFromUser")
  swapRequestsTo         SwapRequest[]               @relation("SwapToUser")
  swapRequestsDecided    SwapRequest[]               @relation("SwapDecider")
  notifications          Notification[]
  notificationPreference UserNotificationPreference?
  weekNotes              WeekNote[]                  @relation("WeekNoteSubject")
  weekNotesCreated       WeekNote[]                  @relation("WeekNoteCreator")

  @@map("users")
}

model ShiftType {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  color            String
  defaultStartTime String
  defaultEndTime   String
  crossesMidnight  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts Shift[]

  @@map("shift_types")
}

model Shift {
  id            String   @id @default(cuid())
  teamId        String
  userId        String
  // `date` is the calendar day the shift belongs to (YYYY-MM-DD). It is
  // stored as a String rather than a DateTime / @db.Date so it can never be
  // shifted across timezones at the JSON/React boundary. A shift on the 27th
  // is the 27th regardless of where the user is reading from. Format and
  // validity are enforced by Zod (`dateString` in lib/validation/schemas.ts).
  date          String
  startDateTime DateTime
  endDateTime   DateTime
  shiftTypeId   String
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team            Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftType       ShiftType     @relation(fields: [shiftTypeId], references: [id], onDelete: Restrict)
  swapRequests    SwapRequest[] @relation("SwapFromShift")
  swapRequestsTo  SwapRequest[] @relation("SwapToShift")

  @@unique([userId, date])
  @@index([teamId, date])
  @@map("shifts")
}

model Note {
  id              String         @id @default(cuid())
  teamId          String
  createdByUserId String
  type            NoteType
  status          RequestStatus  @default(PENDING)
  title           String?
  body            String
  dateFrom        String
  dateTo          String
  visibility      NoteVisibility @default(ALL)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("NoteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, dateFrom, dateTo])
  @@map("notes")
}

model SwapRequest {
  id                String        @id @default(cuid())
  teamId            String
  requestedByUserId String
  fromUserId        String
  toUserId          String
  shiftId           String
  toShiftId         String?
  status            RequestStatus @default(PENDING)
  message           String?
  createdAt         DateTime      @default(now())
  decidedBy         String?
  decidedAt         DateTime?

  team          Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requestedBy   User   @relation("SwapRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  fromUser      User   @relation("SwapFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User   @relation("SwapToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  shift         Shift  @relation("SwapFromShift", fields: [shiftId], references: [id], onDelete: Cascade)
  toShift       Shift? @relation("SwapToShift", fields: [toShiftId], references: [id], onDelete: SetNull)
  decidedByUser User?  @relation("SwapDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([requestedByUserId])
  @@map("swap_requests")
}

model Notification {
  id        String   @id @default(cuid())
  teamId    String
  userId    String?
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, userId, read])
  @@map("notifications")
}

model NotificationSettings {
  id           String   @id @default(cuid())
  teamId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEndpoint  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationDeliveryLog {
  id                String          @id @default(cuid())
  teamId            String
  userId            String?
  channel           DeliveryChannel
  notificationType  String
  recipient         String
  status            DeliveryStatus
  errorMessage      String?
  createdAt         DateTime        @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("notification_delivery_log")
}

model UserNotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  shiftChangesEmail Boolean  @default(true)
  shiftChangesSms   Boolean  @default(false)
  swapEmail         Boolean  @default(true)
  swapSms           Boolean  @default(false)
  noteEmail         Boolean  @default(true)
  noteSms           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_preferences")
}

model TeamMembership {
  id        String         @id @default(cuid())
  userId    String
  teamId    String
  role      MembershipRole
  status    ActiveStatus   @default(active)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("team_memberships")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String
  beforeJson  String?
  afterJson   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

model HolidayRequest {
  id        String        @id @default(cuid())
  teamId    String
  userId    String
  type      String
  status    RequestStatus @default(PENDING)
  dateFrom  String
  dateTo    String?
  message   String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedByUser User? @relation("HolidayDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@map("holiday_requests")
}

model WeekNote {
  id        String   @id @default(cuid())
  teamId    String
  /// The employee the note is *about*. Week notes are per-employee
  /// ("fokus for uka" for this person), not per-team.
  userId    String
  /// ISO 8601 week-year. Use this together with isoWeek instead of a calendar
  /// year because ISO weeks at the start/end of the year may belong to the
  /// previous/next ISO year (e.g. 2024-12-30 is in ISO week 2025-W01).
  isoYear   Int
  /// ISO week number (1-53).
  isoWeek   Int
  body      String
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User  @relation("WeekNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  creator User? @relation("WeekNoteCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  /// At most one note per (team, user, ISO year, ISO week). The upsert API
  /// relies on this constraint to make writes idempotent. Repeated saves
  /// merge into the same row instead of producing duplicates.
  @@unique([teamId, userId, isoYear, isoWeek])
  @@index([teamId, userId, isoYear, isoWeek])
  @@map("week_notes")
}

model RotationPattern {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  /// Number of weeks in the rotation cycle (1-8). Validated at the
  /// API boundary via Zod; this comment documents the intent.
  weeks     Int
  /// JSON array of slots. Shape:
  ///   [{ userId, weekIndex, dayOfWeek, shiftTypeId }]
  /// - weekIndex: 0-based (< weeks)
  /// - dayOfWeek: 1=Mon ... 7=Sun (ISO 8601)
  /// Slot integrity (user/shift type existence, team membership) is
  /// validated by the service at write time.
  slotsJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("rotation_patterns")
}
